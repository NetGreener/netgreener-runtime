        "http_method": {
          "type": "string",
          "pattern": "^[A-Z]{3,12}$"
        },
        "route_template": {
          "type": "string",
          "pattern": "^(__unknown__|/[^?#\\r\\n]{0,198})$"
        }
      },
      "required": [
        "kind",
        "unit_type",
        "name",
        "identity_source"
      ]

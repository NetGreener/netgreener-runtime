        "operation_event": {
          "$ref": "#/$defs/OperationEvent"
        },
        "operation_summary": {
          "$ref": "#/$defs/OperationSummary"
        },
        "external_call": {
          "$ref": "#/$defs/ExternalCall"
        },
        "resource_sample": {
          "$ref": "#/$defs/ResourceSample"
        },
        "adapter_health": {
          "$ref": "#/$defs/AdapterHealth"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "wall_time_unix_nano",
        "clock_source"

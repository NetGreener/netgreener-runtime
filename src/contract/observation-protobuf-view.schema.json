      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "operation_event"
              ]
            },
            {
              "required": [
                "operation_summary"
              ]
            },
            {
              "required": [
                "external_call"
              ]
            },
            {
              "required": [
                "resource_sample"
              ]
            },
            {
              "required": [
                "adapter_health"
              ]
            }
          ]
        }
      ]
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "OPERATION_KIND_UNSPECIFIED",
            "OPERATION_KIND_HTTP_SERVER",
            "OPERATION_KIND_TASK",
            "OPERATION_KIND_PROCESS",
            "OPERATION_KIND_SCRIPT",
            "OPERATION_KIND_CRON",
            "OPERATION_KIND_BACKGROUND",
            "OPERATION_KIND_UNATTRIBUTED"
          ]
        },
        "unit_type": {
          "type": "string",
          "enum": [
            "OPERATION_UNIT_UNSPECIFIED",
            "OPERATION_UNIT_HTTP_ROUTE",
            "OPERATION_UNIT_TASK",
            "OPERATION_UNIT_PROCESS",
            "OPERATION_UNIT_SCRIPT",
            "OPERATION_UNIT_CRON",
            "OPERATION_UNIT_BACKGROUND",
            "OPERATION_UNIT_UNATTRIBUTED"

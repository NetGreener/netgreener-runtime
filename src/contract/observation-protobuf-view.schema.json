            "IDENTITY_SOURCE_FRAMEWORK_TEMPLATE",
            "IDENTITY_SOURCE_DECLARED",
            "IDENTITY_SOURCE_GENERATED",
            "IDENTITY_SOURCE_UNKNOWN_BUCKET"

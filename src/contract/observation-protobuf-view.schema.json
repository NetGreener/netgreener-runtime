{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.netgreener.com/contracts/v1/observation-protobuf-view.schema.json",
  "title": "NetGreener Observation v1 Protobuf structural JSON view",
  "$comment": "Generated from observation/v1/source/*.proto (ADR 0009). Structural wire/conformance view. Semantic authoring/TCK fixtures still use observation-envelope.schema.json until consumer migration completes.",
  "$ref": "#/$defs/ObservationBatch",
  "$defs": {
    "ObservationBatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_major": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "protocol_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "batch_id": {
          "type": "string",
          "pattern": "^bat_[0-9a-f]{64}$"
        },
        "batch_sequence": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
          "allOf": [
            {
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          ]
        },
        "emitted_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "routing": {
          "$ref": "#/$defs/Routing"
        },
        "privacy": {
          "$ref": "#/$defs/Privacy"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "protocol_major",
        "protocol_minor",
        "batch_id",
        "batch_sequence",
        "emitted_at",
        "source",
        "routing",
        "privacy",
        "events"
      ]
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+-]{0,31}$"
        },
        "runtime_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "runtime_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,79}$"
        },
        "adapter_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        },
        "adapter_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,79}$"
        },
        "runtime_instance_id": {
          "type": "string",
          "pattern": "^rti_[0-9a-f]{64}$"
        },
        "capability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CAP-R[1-6]$"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "framework": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "deployment_mode": {
          "type": "string",
          "enum": [
            "DEPLOYMENT_MODE_UNSPECIFIED",
            "DEPLOYMENT_MODE_VM",
            "DEPLOYMENT_MODE_CONTAINER",
            "DEPLOYMENT_MODE_KUBERNETES",
            "DEPLOYMENT_MODE_CI_JOB",
            "DEPLOYMENT_MODE_SERVERLESS_THIN",
            "DEPLOYMENT_MODE_LOCAL",
            "DEPLOYMENT_MODE_UNKNOWN"
          ]
        }
      },
      "required": [
        "language",
        "runtime_name",
        "runtime_version",
        "adapter_name",
        "adapter_version",
        "runtime_instance_id",
        "capability_ids",
        "deployment_mode"
      ]
    },
    "Routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
          "allOf": [
            {
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          ]
        },
        "project_id": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
          "allOf": [
            {
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          ]
        },
        "workload_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,199}$"
        },
        "service_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,49}$"
        },
        "release_tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        }
      },
      "required": [
        "project_id",
        "workload_id",
        "service_name"
      ]
    },
    "Privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_capture": {
          "type": "string",
          "enum": [
            "CONTENT_CAPTURE_UNSPECIFIED",
            "CONTENT_CAPTURE_NONE"

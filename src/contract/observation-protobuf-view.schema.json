    "ExternalCall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent_operation_event_id": {
          "type": "string",
          "pattern": "^evt_[0-9a-f]{64}$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
        },
